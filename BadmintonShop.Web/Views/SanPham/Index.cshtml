@model List<BadmintonShop.Core.Models.SanPham>

@{
    ViewData["Title"] = "Sản phẩm";

    string? tuKhoa = ViewBag.TuKhoa;
    int? maDM = ViewBag.MaDM;
    string? sapXep = ViewBag.SapXep;

    int trangHienTai = ViewBag.TrangHienTai ?? 1;
    int tongSoTrang = ViewBag.TongSoTrang ?? 1;
    int tongSanPham = ViewBag.TongSanPham ?? Model.Count;

    var danhMuc = (ViewBag.DanhMuc as IEnumerable<BadmintonShop.Core.Models.DanhMuc>)?.ToList()
                  ?? new List<BadmintonShop.Core.Models.DanhMuc>();

    string? TenDM(int ma) => danhMuc.FirstOrDefault(d => d.MaDM == ma)?.TenDanhMuc;
    bool dangLoc = !string.IsNullOrWhiteSpace(tuKhoa) || maDM != null || !string.IsNullOrEmpty(sapXep);
}

<div class="container mx-auto px-4 py-12">
    <h1 class="page-title !mb-2">Tất cả sản phẩm</h1>
    <p class="text-sm text-gray-600 mb-8">Vợt, giày, cầu, quần áo và phụ kiện chính hãng. Lọc theo danh mục hoặc thương hiệu để so sánh.</p>

    <form asp-controller="SanPham" asp-action="Index" method="get" class="loc-thanh" role="search">
        <div class="md:col-span-5">
            <label for="tuKhoa" class="field-label">Tìm kiếm</label>
            <input id="tuKhoa" type="text" name="tuKhoa" value="@tuKhoa" class="input-box"
                   placeholder="Tên sản phẩm hoặc thương hiệu" />
        </div>

        <div class="md:col-span-3">
            <label for="maDM" class="field-label">Danh mục</label>
            <select id="maDM" name="maDM" class="input-box">
                <option value="">Tất cả danh mục</option>
                @foreach (var dm in danhMuc)
                {
                    <option value="@dm.MaDM" selected="@(maDM == dm.MaDM)">@dm.TenDanhMuc</option>
                }
            </select>
        </div>

        <div class="md:col-span-2">
            <label for="sapXep" class="field-label">Sắp xếp</label>
            <select id="sapXep" name="sapXep" class="input-box">
                <option value="" selected="@(string.IsNullOrEmpty(sapXep))">Tên A - Z</option>
                <option value="ten-z-a" selected="@(sapXep == "ten-z-a")">Tên Z - A</option>
                <option value="gia-tang" selected="@(sapXep == "gia-tang")">Giá thấp đến cao</option>
                <option value="gia-giam" selected="@(sapXep == "gia-giam")">Giá cao đến thấp</option>
            </select>
        </div>

        <div class="md:col-span-2 flex items-end">
            <button type="submit" class="btn-dark w-full">Áp dụng</button>
            <button type="submit" name="lamMoi" value="true" class="btn-outline">Làm mới</button>
        </div>
    </form>

    <div class="flex items-center justify-between mb-6 text-sm">
        <p class="font-bold">@tongSanPham sản phẩm</p>
        <div class="flex items-center gap-4 text-gray-500">
            @if (dangLoc)
            {
                <a asp-controller="SanPham" asp-action="Index" class="link-sub">Xóa bộ lọc</a>
            }
            @if (tongSoTrang > 1)
            {
                <span class="tabular-nums">Trang @trangHienTai / @tongSoTrang</span>
            }
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="border border-gray-200 py-20 text-center">
            <p class="font-bold mb-2">Không tìm thấy sản phẩm phù hợp.</p>
            <p class="text-sm text-gray-600 mb-6">Thử đổi từ khóa hoặc bỏ bớt bộ lọc.</p>
            <a asp-controller="SanPham" asp-action="Index" class="btn-outline">Xem tất cả sản phẩm</a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-4 gap-y-10 md:gap-x-6">
            @foreach (var sp in Model)
            {
                <partial name="_SanPhamCard" model="new TheSanPham { SanPham = sp, TenDanhMuc = TenDM(sp.MaDM) }" />
            }
        </div>
    }

    @if (tongSoTrang > 1)
    {
        <nav class="phan-trang mt-14 flex flex-wrap items-center justify-center gap-2" aria-label="Phân trang sản phẩm">
            @if (trangHienTai == 1)
            {
                <span class="tat" aria-disabled="true">Trước</span>
            }
            else
            {
                <a asp-controller="SanPham" asp-action="Index" asp-route-tuKhoa="@tuKhoa" asp-route-maDM="@maDM"
                   asp-route-sapXep="@sapXep" asp-route-trang="@(trangHienTai - 1)">Trước</a>
            }

            @for (int i = 1; i <= tongSoTrang; i++)
            {
                if (i == trangHienTai)
                {
                    <span class="dang-chon" aria-current="page">@i</span>
                }
                else
                {
                    <a asp-controller="SanPham" asp-action="Index" asp-route-tuKhoa="@tuKhoa" asp-route-maDM="@maDM"
                       asp-route-sapXep="@sapXep" asp-route-trang="@i">@i</a>
                }
            }

            @if (trangHienTai == tongSoTrang)
            {
                <span class="tat" aria-disabled="true">Sau</span>
            }
            else
            {
                <a asp-controller="SanPham" asp-action="Index" asp-route-tuKhoa="@tuKhoa" asp-route-maDM="@maDM"
                   asp-route-sapXep="@sapXep" asp-route-trang="@(trangHienTai + 1)">Sau</a>
            }
        </nav>
    }
</div>
