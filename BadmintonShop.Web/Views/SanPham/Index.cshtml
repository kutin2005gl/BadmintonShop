@model List<BadmintonShop.Core.Models.SanPham>

@{
    ViewData["Title"] = "Danh sách sản phẩm";

    string? tuKhoa = ViewBag.TuKhoa;
    int? maDM = ViewBag.MaDM;
    string? sapXep = ViewBag.SapXep;

    int trangHienTai = ViewBag.TrangHienTai ?? 1;
    int tongSoTrang = ViewBag.TongSoTrang ?? 1;
    int tongSanPham = ViewBag.TongSanPham ?? Model.Count;

    // Danh mục sẽ lấy từ SQL Server ở bước tiếp theo.
    // Hiện tại không tự tạo dữ liệu danh mục giả.
    var danhMuc = ViewBag.DanhMuc as
        IEnumerable<BadmintonShop.Core.Models.DanhMuc>;
}

<div class="container mt-4">

    <!-- Tiêu đề -->
    <div class="text-center mb-4">
        <h2 class="fw-bold">Sản phẩm cầu lông</h2>
        <p class="text-muted">
            Khám phá các sản phẩm thể thao cầu lông tại BadmintonShop
        </p>
    </div>

    <!-- Tìm kiếm, lọc và sắp xếp -->
    <form asp-controller="SanPham"
          asp-action="Index"
          method="get"
          class="card shadow-sm mb-4">

        <div class="card-body">
            <div class="row g-3">

                <!-- Tìm kiếm -->
                <div class="col-md-12">
                    <label class="form-label fw-semibold">
                        Tìm kiếm sản phẩm
                    </label>

                    <input type="text"
                           name="tuKhoa"
                           value="@tuKhoa"
                           class="form-control"
                           placeholder="Nhập tên sản phẩm hoặc thương hiệu..." />
                </div>

                <!-- Danh mục -->
                <div class="col-md-5">
                    <label class="form-label fw-semibold">
                        Danh mục sản phẩm
                    </label>

                    <select name="maDM" class="form-select">
                        <option value="">Tất cả danh mục</option>

                        @if (danhMuc != null)
                        {
                            @foreach (var dm in danhMuc)
                            {
                                if (maDM == dm.MaDM)
                                {
                                    <option value="@dm.MaDM" selected>
                                        @dm.TenDanhMuc
                                    </option>
                                }
                                else
                                {
                                    <option value="@dm.MaDM">
                                        @dm.TenDanhMuc
                                    </option>
                                }
                            }
                        }
                    </select>
                </div>

                <!-- Sắp xếp -->
                <div class="col-md-5">
                    <label class="form-label fw-semibold">
                        Sắp xếp theo
                    </label>

                    <select name="sapXep" class="form-select">

                        <option value=""
                                selected="@(string.IsNullOrEmpty(sapXep))">
                            Tên A - Z
                        </option>

                        <option value="ten-z-a"
                                selected="@(sapXep == "ten-z-a")">
                            Tên Z - A
                        </option>

                        <option value="gia-tang"
                                selected="@(sapXep == "gia-tang")">
                            Giá thấp đến cao
                        </option>

                        <option value="gia-giam"
                                selected="@(sapXep == "gia-giam")">
                            Giá cao đến thấp
                        </option>

                    </select>
                </div>

                <!-- Nút tìm kiếm -->
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Áp dụng
                    </button>
                </div>

            </div>

            <div class="mt-3">
                <a asp-controller="SanPham"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-sm">
                    Xóa bộ lọc
                </a>
            </div>
        </div>
    </form>

    <!-- Tổng sản phẩm -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <strong>
            Tìm thấy @tongSanPham sản phẩm
        </strong>

        <span class="text-muted small">
            Trang @trangHienTai / @tongSoTrang
        </span>
    </div>

    <!-- Danh sách sản phẩm -->
    <div class="row g-4">

        @foreach (var sp in Model)
        {
            // Chuẩn hóa khóa ảnh
            var khoaAnh = sp.HinhAnh?.Replace('\\', '/');

            var tenFile = khoaAnh?
                .Replace("products/", "", StringComparison.OrdinalIgnoreCase);

            var hopLe = !string.IsNullOrWhiteSpace(tenFile)
                && tenFile.IndexOfAny(new[] { '/', '\\', ':' }) < 0
                && tenFile != "."
                && tenFile != "..";

            var duongDanAnh = hopLe
                ? Url.Content("~/media/products/" + Uri.EscapeDataString(tenFile!))
                : null;

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 shadow-sm">

                    <!-- Hình ảnh -->
                    @if (duongDanAnh != null)
                    {
                        <img src="@duongDanAnh"
                             class="card-img-top"
                             alt="@sp.TenSP"
                             style="height:220px; object-fit:contain;"
                             onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex';" />

                        <div class="bg-light align-items-center justify-content-center"
                             style="height:220px; display:none;">
                            <span class="text-muted">
                                Không tải được hình ảnh
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center"
                             style="height:220px;">
                            <span class="text-muted">
                                Chưa có hình ảnh
                            </span>
                        </div>
                    }

                    <!-- Thông tin -->
                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">
                            @sp.TenSP
                        </h5>

                        <p class="text-muted small mb-2">
                            Thương hiệu:
                            @(sp.ThuongHieu ?? "Đang cập nhật")
                        </p>

                        <p class="text-danger fw-bold fs-5">
                            @sp.DonGiaBan.ToString("N0") đ
                        </p>

                        @if (sp.SoLuongTon > 0)
                        {
                            <span class="text-success small mb-3">
                                Còn hàng: @sp.SoLuongTon
                            </span>
                        }
                        else
                        {
                            <span class="text-danger small mb-3">
                                Hết hàng
                            </span>
                        }

                        <a asp-controller="SanPham"
                           asp-action="ChiTiet"
                           asp-route-id="@sp.MaSP"
                           class="btn btn-outline-primary mt-auto">
                            Xem chi tiết
                        </a>

                    </div>
                </div>
            </div>
        }

    </div>

    <!-- Không có kết quả -->
    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center mt-4">
            Không tìm thấy sản phẩm phù hợp.
        </div>
    }

    <!-- Phân trang -->
    @if (tongSoTrang > 1)
    {
        <nav class="mt-5" aria-label="Phân trang sản phẩm">
            <ul class="pagination justify-content-center">

                <!-- Trang trước -->
                <li class="page-item @(trangHienTai == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="SanPham"
                       asp-action="Index"
                       asp-route-tuKhoa="@tuKhoa"
                       asp-route-maDM="@maDM"
                       asp-route-sapXep="@sapXep"
                       asp-route-trang="@(trangHienTai - 1)">
                        Trước
                    </a>
                </li>

                <!-- Các số trang -->
                @for (int i = 1; i <= tongSoTrang; i++)
                {
                    <li class="page-item @(i == trangHienTai ? "active" : "")">
                        <a class="page-link"
                           asp-controller="SanPham"
                           asp-action="Index"
                           asp-route-tuKhoa="@tuKhoa"
                           asp-route-maDM="@maDM"
                           asp-route-sapXep="@sapXep"
                           asp-route-trang="@i">
                            @i
                        </a>
                    </li>
                }

                <!-- Trang sau -->
                <li class="page-item @(trangHienTai == tongSoTrang ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="SanPham"
                       asp-action="Index"
                       asp-route-tuKhoa="@tuKhoa"
                       asp-route-maDM="@maDM"
                       asp-route-sapXep="@sapXep"
                       asp-route-trang="@(trangHienTai + 1)">
                        Sau
                    </a>
                </li>

            </ul>
        </nav>
    }

</div>
