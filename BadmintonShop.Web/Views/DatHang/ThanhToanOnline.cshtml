@model BadmintonShop.Core.Models.HoaDon
@{ ViewData["Title"] = "Thanh toán online"; }

<div class="container mx-auto px-4 py-12">
<div class="mx-auto max-w-md bg-gray-50 p-8 text-center">
    <h1 class="text-xl font-extrabold uppercase tracking-tight mb-2">Cổng thanh toán (giả lập)</h1>
    <p class="text-gray-500 text-sm mb-6">Đây là màn hình mô phỏng, không có giao dịch thật.</p>
    <p class="text-sm mb-1">Đơn hàng <strong>#@Model.MaHD</strong></p>
    <p class="text-3xl font-extrabold tracking-tight mb-8">@Model.TongTien.Dong()</p>
    <form asp-action="ThanhToanOnline" asp-route-id="@Model.MaHD" method="post" class="flex flex-col gap-3">
        <button type="submit" class="btn-accent w-full">Xác nhận đã thanh toán</button>
        <a asp-controller="DonHang" asp-action="ChiTiet" asp-route-id="@Model.MaHD" class="text-sm font-bold uppercase underline hover:text-primary">Thanh toán sau</a>
    </form>
</div>
</div>
