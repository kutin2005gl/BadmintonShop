@model ChiTietDonViewModel
@using System.Data
@using BadmintonShop.Web.Infrastructure
@{
    var hd = Model.Don;
    var coForm = ViewData["NangCap"] as string == "form";
    var dong = Model.Dong.Rows.Cast<DataRow>().ToList();
    var soMon = dong.Sum(r => Convert.ToInt32(r["SoLuong"]));
    var tamTinh = dong.Sum(r => (decimal)r["ThanhTien"]);
    var loiNC = TempData["LoiNangCap"] as string;
    var cacBuoc = new[] { ("Chờ xác nhận", "Đã đặt hàng"), ("Đã xác nhận", "Xác nhận"), ("Đang giao", "Vận chuyển"), ("Hoàn thành", "Hoàn tất") };
    var viTri = Array.FindIndex(cacBuoc, b => b.Item1 == hd.TrangThai);
}

<style>
    html:has(dialog[open]) { overflow: hidden; }
    .ngan-keo::backdrop { background: rgba(0, 0, 0, .5); }
    .ngan-keo[open] { animation: ngan-keo-vao .25s ease-out; }
    @@keyframes ngan-keo-vao { from { transform: translateX(100%); } to { transform: translateX(0); } }
    @@media (prefers-reduced-motion: reduce) { .ngan-keo[open] { animation: none; } }
</style>

<div class="mx-auto max-w-2xl px-4 py-10">
    <div class="flex items-center gap-4 mb-6">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-green-50 text-green-600">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        </div>
        <div>
            <p class="text-xs uppercase text-gray-500">Đơn hàng #@hd.MaHD</p>
            <h1 class="text-xl md:text-2xl font-bold">Đặt hàng thành công!</h1>
            <p class="text-sm text-gray-500">Cảm ơn bạn đã lựa chọn BadmintonShop.</p>
        </div>
    </div>
    @if (TempData["ThongBao"] is string tb) { <div class="alert-ok rounded-md" role="status">@tb</div> }

    <section class="rounded-lg border border-gray-200 p-4 md:p-5 mb-4">
        <h2 class="text-sm font-bold mb-5">Trạng thái đơn hàng</h2>
        @if (hd.TrangThai == "Đã hủy")
        {
            <div class="alert-err rounded-md mb-0">Đơn hàng này đã bị hủy. @hd.LyDoHuy</div>
        }
        else
        {
            <ol class="grid grid-cols-4">
                @for (var i = 0; i < cacBuoc.Length; i++)
                {
                    var xong = i <= viTri;
                    <li class="relative flex flex-col items-center text-center" aria-current="@(i == viTri ? "step" : null)">
                        @if (i > 0) { <span class="absolute right-1/2 top-5 h-0.5 w-full @(xong ? "bg-black" : "bg-gray-200")" aria-hidden="true"></span> }
                        <span class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full border-2 text-base @(xong ? "border-black bg-black text-white" : "border-gray-200 bg-gray-100 text-gray-500")">
                            @if (xong)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-label="Đã xong"><path d="M20 6 9 17l-5-5"/></svg>
                            }
                            else { @(i + 1) }
                        </span>
                        <span class="mt-3 text-xs sm:text-sm @(xong ? "font-bold text-black" : "text-gray-500")">@cacBuoc[i].Item2</span>
                    </li>
                }
            </ol>
        }
    </section>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <section class="rounded-lg border border-gray-200 p-4">
            <h2 class="text-sm font-bold border-b border-gray-200 pb-3 mb-3">Thông tin giao hàng</h2>
            <dl class="text-sm">
                <dt class="text-xs text-gray-500">Địa chỉ nhận hàng</dt>
                <dd class="mb-3 mt-1 break-words">@hd.DiaChiGiao</dd>
                <dt class="text-xs text-gray-500">Phương thức thanh toán</dt>
                <dd class="mb-3 mt-1">@(hd.HinhThucTT == "COD" ? "Khi nhận hàng (COD)" : "Online")</dd>
                <dt class="text-xs text-gray-500">Mã đơn hàng</dt>
                <dd class="mt-1 font-bold">#@hd.MaHD</dd>
                @if (!string.IsNullOrWhiteSpace(hd.GhiChu))
                {
                    <dt class="mt-3 text-xs text-gray-500">Ghi chú</dt>
                    <dd class="mt-1 break-words">@hd.GhiChu</dd>
                }
            </dl>
        </section>

        <section class="flex flex-col rounded-lg border border-gray-200 bg-gray-50 p-4">
            <h2 class="text-sm font-bold border-b border-gray-200 pb-3 mb-3">Tóm tắt đơn hàng</h2>
            @if (dong.Count > 0)
            {
                var r = dong[0];
                var tenSP = (string)r["TenSP"];
                <div class="flex gap-3">
                    <div class="relative h-12 w-12 shrink-0 overflow-hidden rounded bg-white">
                        <img src="@AnhMinhHoa.CuaSanPham(r["HinhAnh"] as string, null)" alt="" data-chu="@tenSP.Substring(0, 1)" class="h-full w-full object-cover" />
                    </div>
                    <div class="min-w-0 text-sm">
                        <p>@tenSP</p>
                        <p class="text-xs text-gray-500 mt-1">Số lượng: @r["SoLuong"]</p>
                    </div>
                </div>
                @if (dong.Count > 1) { <p class="mt-3 text-xs text-gray-500">và @(dong.Count - 1) sản phẩm khác</p> }
            }
            <div class="mt-auto pt-3">
                <div class="border-t border-gray-200 pt-3">
                    <p class="text-xs text-gray-500">Tổng thanh toán</p>
                    <p class="mt-1 text-lg font-bold">@hd.TongTien.Dong()</p>
                    <button type="button" class="mt-2 text-xs font-medium underline underline-offset-2 hover:text-primary transition-colors" data-mo="ngan-chi-tiet" aria-haspopup="dialog">Xem chi tiết đơn hàng</button>
                </div>
            </div>
        </section>
    </div>

    <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a asp-controller="Home" asp-action="Index" class="btn-outline rounded-md border-gray-300 normal-case tracking-normal">Tiếp tục mua sắm</a>
        <a asp-controller="DonHang" asp-action="TraCuu" class="btn-dark rounded-md border border-black normal-case tracking-normal">Tra cứu đơn hàng</a>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-3 rounded-lg border border-gray-200 bg-gray-50 p-4">
        <svg class="shrink-0" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
        <div class="min-w-0 flex-1">
            <p class="text-sm font-bold">@(coForm ? "Trở thành thành viên BadmintonShop" : "Số điện thoại này đã có tài khoản")</p>
            <p class="text-xs text-gray-500 mt-1">@(coForm ? "Quản lý đơn hàng và mua sắm thuận tiện hơn." : "Đăng nhập để xem và quản lý đơn hàng.")</p>
        </div>
        @if (coForm)
        {
            <button type="button" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-xs font-bold hover:border-black transition-colors" data-mo="ngan-dang-ky" aria-haspopup="dialog">Đăng ký</button>
        }
        else
        {
            <a asp-controller="TaiKhoan" asp-action="DangNhap" asp-route-returnUrl="/DonHang" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-xs font-bold hover:border-black transition-colors">Đăng nhập</a>
        }
    </div>
</div>

@* Khung truot: chi tiet don hang *@
<dialog id="ngan-chi-tiet" class="ngan-keo fixed inset-y-0 left-auto right-0 m-0 ml-auto h-full max-h-none w-full max-w-md border-0 bg-white p-0 text-black shadow-2xl" aria-labelledby="tieu-de-chi-tiet">
    <div class="flex h-full flex-col">
        <div class="flex items-start justify-between gap-4 border-b border-gray-100 p-5">
            <div>
                <h2 id="tieu-de-chi-tiet" class="text-lg font-bold">Chi tiết đơn hàng</h2>
                <p class="text-sm text-gray-500">Mã đơn hàng #@hd.MaHD</p>
            </div>
            <button type="button" class="p-1 text-2xl leading-none hover:text-primary" data-dong aria-label="Đóng">&times;</button>
        </div>

        <div class="flex items-center justify-between px-5 pt-4 pb-3">
            <h3 class="text-sm font-bold">Sản phẩm</h3>
            <span class="text-xs text-gray-500">@soMon món</span>
        </div>
        <ul class="min-h-0 flex-1 overflow-y-auto px-5 divide-y divide-gray-100">
            @foreach (var r in dong)
            {
                var tenSP = (string)r["TenSP"];
                <li class="flex gap-4 py-3">
                    <div class="relative h-16 w-16 shrink-0 overflow-hidden rounded-md bg-gray-100">
                        <img src="@AnhMinhHoa.CuaSanPham(r["HinhAnh"] as string, null)" alt="" data-chu="@tenSP.Substring(0, 1)" class="h-full w-full object-cover" />
                    </div>
                    <div class="min-w-0 text-sm">
                        <p class="font-medium">@tenSP</p>
                        <p class="text-gray-500">Số lượng: @r["SoLuong"]</p>
                        <p class="font-bold">@(((decimal)r["ThanhTien"]).Dong())</p>
                    </div>
                </li>
            }
        </ul>

        <div class="p-5">
            <div class="rounded-md bg-gray-50 p-4 text-sm">
                <dl class="space-y-2 border-b border-gray-200 pb-3">
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Tạm tính</dt><dd>@tamTinh.Dong()</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Giảm giá</dt><dd class="@(hd.TienGiamGia > 0 ? "text-green-700" : "")">@(hd.TienGiamGia > 0 ? "-" : "")@hd.TienGiamGia.Dong()</dd></div>
                    <div class="flex justify-between gap-4"><dt class="text-gray-500">Vận chuyển</dt><dd>Miễn phí</dd></div>
                </dl>
                <div class="flex items-center justify-between gap-4 pt-3">
                    <span class="font-bold">Tổng cộng</span>
                    <span class="text-lg font-extrabold">@hd.TongTien.Dong()</span>
                </div>
            </div>
            <button type="button" class="btn-dark mt-4 w-full rounded-full normal-case tracking-normal" data-dong>Đóng chi tiết</button>
        </div>
    </div>
</dialog>

@if (coForm)
{
    @* Khung truot: tao tai khoan; tu mo lai khi form bao loi *@
    <dialog id="ngan-dang-ky" class="ngan-keo fixed inset-y-0 left-auto right-0 m-0 ml-auto h-full max-h-none w-full max-w-md border-0 bg-white p-0 text-black shadow-2xl" aria-labelledby="tieu-de-dang-ky" data-tu-mo="@(loiNC != null ? "co" : "khong")">
        <div class="h-full overflow-y-auto p-5">
            <div class="flex items-start justify-between gap-4 mb-5">
                <div>
                    <h2 id="tieu-de-dang-ky" class="text-lg font-bold">Tạo tài khoản</h2>
                    <p class="text-sm text-gray-500">Đơn hàng đặt bằng số điện thoại này sẽ được gắn vào tài khoản mới.</p>
                </div>
                <button type="button" class="p-1 text-2xl leading-none hover:text-primary" data-dong aria-label="Đóng">&times;</button>
            </div>
            @if (loiNC != null) { <div class="alert-err rounded-md" role="alert">@loiNC</div> }
            <form asp-action="TaoTaiKhoan" asp-route-id="@hd.MaHD" method="post">
                <div class="mb-4">
                    <label for="email" class="block text-sm font-semibold mb-1.5">Email</label>
                    <input id="email" name="email" type="email" value="@(TempData["EmailNangCap"] as string)" class="input-box rounded-md" placeholder="Nhập email của bạn" autocomplete="email" required maxlength="100" />
                </div>
                @foreach (var (id, nhan, goiY) in new[] { ("matKhau", "Mật khẩu", "Nhập mật khẩu"), ("xacNhanMatKhau", "Xác nhận mật khẩu", "Nhập lại mật khẩu") })
                {
                    <div class="mb-4">
                        <label for="@id" class="block text-sm font-semibold mb-1.5">@nhan</label>
                        <div class="relative">
                            <input id="@id" name="@id" type="password" class="input-box rounded-md pr-11" placeholder="@goiY" autocomplete="new-password" required minlength="8" maxlength="100" />
                            <button type="button" class="nut-xem-mk absolute right-1 top-1/2 -translate-y-1/2 p-2 text-gray-400 hover:text-black transition-colors" data-cho="@id" aria-label="Hiện @nhan.ToLower()" aria-pressed="false">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                    </div>
                }
                <p class="text-xs text-gray-500 mb-4">Ít nhất 8 ký tự, gồm chữ hoa, chữ thường và chữ số.</p>
                <button type="submit" class="btn-dark w-full rounded-md normal-case tracking-normal">Tạo tài khoản</button>
            </form>
            <p class="mt-4 text-center text-sm text-gray-500">
                Đã có tài khoản?
                <a asp-controller="TaiKhoan" asp-action="DangNhap" asp-route-returnUrl="/DonHang" class="font-semibold text-black hover:text-primary">Đăng nhập</a>
            </p>
        </div>
    </dialog>
}

<script>
    (function () {
        // TV1: mo khung truot (chi tiet don / dang ky)
        document.querySelectorAll('[data-mo]').forEach(function (nut) {
            nut.addEventListener('click', function () { document.getElementById(nut.getAttribute('data-mo')).showModal(); });
        });
        document.querySelectorAll('dialog.ngan-keo').forEach(function (ngan) {
            // TV1: dong khung khi bam nut dong hoac bam ra nen toi (phim Esc do trinh duyet xu ly)
            ngan.addEventListener('click', function (e) {
                if (e.target === ngan || e.target.closest('[data-dong]')) ngan.close();
            });
            if (ngan.getAttribute('data-tu-mo') === 'co') ngan.showModal();
        });
        // TV1: bat/tat hien mat khau
        document.querySelectorAll('.nut-xem-mk').forEach(function (nut) {
            nut.addEventListener('click', function () {
                var o = document.getElementById(nut.getAttribute('data-cho'));
                var hien = o.type === 'password';
                o.type = hien ? 'text' : 'password';
                nut.setAttribute('aria-pressed', hien);
                nut.classList.toggle('text-black', hien);
            });
        });
    })();
</script>
