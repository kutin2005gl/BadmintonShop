@model BadmintonShop.Web.Models.DangNhapViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-khung">
    <div class="auth-card">
        <h1 class="auth-title">Đăng nhập</h1>
        <p class="auth-sub">Đăng nhập để đặt hàng, theo dõi đơn và đánh giá sản phẩm.</p>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert-ok">@TempData["ThongBao"]</div>
        }

        <form asp-controller="TaiKhoan" asp-action="DangNhap" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert-err"></div>

            <div class="field">
                <label asp-for="Email" class="field-label"></label>
                <input asp-for="Email" class="input-box" placeholder="ten@email.com" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="MatKhau" class="field-label"></label>
                <input asp-for="MatKhau" class="input-box" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                <span asp-validation-for="MatKhau" class="field-error"></span>
            </div>

            <div class="flex items-center justify-between mb-6">
                <label class="flex items-center gap-2 text-sm cursor-pointer">
                    <input asp-for="GhiNho" class="w-4 h-4" />
                    <span>@Html.DisplayNameFor(m => m.GhiNho)</span>
                </label>
                <a asp-controller="TaiKhoan" asp-action="QuenMatKhau" class="link-sub">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn-dark w-full">Đăng nhập</button>
        </form>

        <div class="border-t border-gray-200 mt-8 pt-6 text-sm text-gray-600 text-center">
            Chưa có tài khoản?
            <a asp-controller="TaiKhoan" asp-action="DangKy" class="link-sub ml-1">Đăng ký ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
