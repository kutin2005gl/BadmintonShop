@model BadmintonShop.Web.Models.QuenMatKhauViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="auth-khung">
    <div class="auth-card">
        <h1 class="auth-title">Quên mật khẩu</h1>
        <p class="auth-sub">Nhập email đã đăng ký tài khoản BadmintonShop để nhận mã OTP mô phỏng.</p>

        <form asp-controller="TaiKhoan" asp-action="QuenMatKhau" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert-err"></div>

            <div class="field">
                <label asp-for="Email" class="field-label"></label>
                <input asp-for="Email" class="input-box" type="email" placeholder="ten@email.com" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <button type="submit" class="btn-dark w-full">Tạo mã OTP</button>
        </form>

        <div class="border-t border-gray-200 mt-8 pt-6 text-center">
            <a asp-controller="TaiKhoan" asp-action="DangNhap" class="link-sub">&larr; Quay lại đăng nhập</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
