@model BadmintonShop.Web.Models.QuenMatKhauViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Quên mật khẩu</h4>
                </div>

                <div class="card-body p-4">
                    <p class="text-muted">
                        Nhập email đã đăng ký tài khoản BadmintonShop
                        để nhận mã OTP mô phỏng.
                    </p>

                    <form asp-controller="TaiKhoan"
                          asp-action="QuenMatKhau"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label"></label>

                            <input asp-for="Email"
                                   class="form-control"
                                   type="email"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Tạo mã OTP
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-controller="TaiKhoan"
                           asp-action="DangNhap">
                            Quay lại đăng nhập
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
