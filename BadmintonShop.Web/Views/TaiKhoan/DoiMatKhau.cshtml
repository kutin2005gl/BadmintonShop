@model BadmintonShop.Web.Models.DoiMatKhauViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="auth-khung">
    <div class="auth-card">
        <h1 class="auth-title">Đổi mật khẩu</h1>
        <p class="auth-sub">Nhập mật khẩu hiện tại và mật khẩu mới của bạn.</p>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert-ok">@TempData["ThongBao"]</div>
        }

        <form asp-controller="TaiKhoan" asp-action="DoiMatKhau" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert-err"></div>

            <div class="field">
                <label asp-for="MatKhauHienTai" class="field-label"></label>
                <input asp-for="MatKhauHienTai" class="input-box" autocomplete="current-password" />
                <span asp-validation-for="MatKhauHienTai" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="MatKhauMoi" class="field-label"></label>
                <input asp-for="MatKhauMoi" class="input-box" autocomplete="new-password" />
                <span asp-validation-for="MatKhauMoi" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="XacNhanMatKhau" class="field-label"></label>
                <input asp-for="XacNhanMatKhau" class="input-box" autocomplete="new-password" />
                <span asp-validation-for="XacNhanMatKhau" class="field-error"></span>
            </div>

            <button type="submit" class="btn-dark w-full">Xác nhận đổi mật khẩu</button>
        </form>

        <div class="border-t border-gray-200 mt-8 pt-6 text-center">
            <a asp-controller="TaiKhoan" asp-action="HoSo" class="link-sub">&larr; Quay lại hồ sơ cá nhân</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
