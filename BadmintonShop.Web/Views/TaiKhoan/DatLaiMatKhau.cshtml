@model BadmintonShop.Web.Models.DatLaiMatKhauViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="auth-khung">
    <div class="auth-card">
        <h1 class="auth-title">Đặt lại mật khẩu</h1>
        <p class="auth-sub">Xác minh OTP thành công. Hãy nhập mật khẩu mới cho tài khoản của bạn.</p>

        <form asp-controller="TaiKhoan" asp-action="DatLaiMatKhau" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert-err"></div>

            <div class="field">
                <label asp-for="MatKhauMoi" class="field-label"></label>
                <input asp-for="MatKhauMoi" class="input-box" autocomplete="new-password" />
                <span asp-validation-for="MatKhauMoi" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="XacNhanMatKhau" class="field-label"></label>
                <input asp-for="XacNhanMatKhau" class="input-box" autocomplete="new-password" />
                <span asp-validation-for="XacNhanMatKhau" class="field-error"></span>
            </div>

            <button type="submit" class="btn-dark w-full">Xác nhận đặt lại mật khẩu</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
