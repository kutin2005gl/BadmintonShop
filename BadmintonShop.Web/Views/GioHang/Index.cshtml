@model KetQuaGioHang
@using BadmintonShop.Core.Models
@{ ViewData["Title"] = "Giỏ hàng"; }

<div class="container mx-auto px-4 py-12">
<h1 class="page-title">Giỏ hàng</h1>

@if (TempData["ThongBao"] is string tb) { <div class="alert-ok">@tb</div> }
@if (TempData["Loi"] is string loi) { <div class="alert-err">@loi</div> }
@foreach (var cb in Model.CanhBao) { <div class="alert-warn">@cb</div> }

@if (Model.Dong.Count == 0)
{
    <div class="flex flex-col items-center justify-center text-center py-16">
        <p class="text-gray-500 mb-8 max-w-md">Giỏ hàng đang trống. Hãy quay lại cửa hàng để chọn những sản phẩm ưng ý nhất nhé.</p>
        <a asp-controller="Home" asp-action="Index" class="btn-dark">Tiếp tục mua sắm</a>
    </div>
}
else
{
    <div class="flex flex-col lg:flex-row gap-12">
        <div class="w-full lg:w-2/3">
            <div class="hidden md:grid grid-cols-12 gap-4 pb-4 border-b border-black mb-6 text-sm font-bold uppercase tracking-wider text-gray-500">
                <div class="col-span-5">Sản phẩm</div>
                <div class="col-span-3 text-center">Số lượng</div>
                <div class="col-span-3 text-right">Thành tiền</div>
                <div class="col-span-1"></div>
            </div>

            <div class="space-y-6">
            @foreach (var d in Model.Dong)
            {
                <div class="flex flex-col md:grid md:grid-cols-12 gap-4 md:items-center border-b border-gray-200 pb-6">
                    <div class="col-span-5 flex gap-4">
                      <div class="w-20 h-20 bg-gray-50 shrink-0 flex items-center justify-center text-2xl font-extrabold text-gray-200">@d.TenSP.Substring(0, 1)</div>
                      <div>
                        <div class="font-bold uppercase text-sm mb-1">@d.TenSP</div>
                        @if (d.PhanTramGiam > 0)
                        {
                            <div class="text-sm">
                                <span class="badge bg-red-500 text-white">-@d.PhanTramGiam.ToString("0.##")%</span>
                                <span class="text-gray-400 line-through ml-1">@d.DonGia.Dong()</span>
                            </div>
                        }
                        <div class="text-sm text-gray-600">@d.DonGiaSauGiam.Dong()</div>
                        @if (!d.DuHang) { <span class="badge bg-red-500 text-white mt-1">Chỉ còn @d.TonKho</span> }
                      </div>
                    </div>

                    <div class="col-span-3 flex md:justify-center">
                        <div class="flex items-center border border-black">
                            <form asp-action="CapNhat" method="post">
                                <input type="hidden" name="maSP" value="@d.MaSP" /><input type="hidden" name="soLuong" value="@(d.SoLuong - 1)" />
                                <button type="submit" class="w-9 h-9 hover:bg-gray-100 font-bold" aria-label="Giảm">&minus;</button>
                            </form>
                            <span class="w-12 text-center font-bold">@d.SoLuong</span>
                            <form asp-action="CapNhat" method="post">
                                <input type="hidden" name="maSP" value="@d.MaSP" /><input type="hidden" name="soLuong" value="@(d.SoLuong + 1)" />
                                <button type="submit" class="w-9 h-9 hover:bg-gray-100 font-bold" aria-label="Tăng">+</button>
                            </form>
                        </div>
                    </div>

                    <div class="col-span-3 flex justify-between md:justify-end font-extrabold text-lg">
                        <span class="md:hidden text-gray-500 font-medium text-sm">Thành tiền:</span>
                        @d.ThanhTien.Dong()
                    </div>

                    <div class="col-span-1 flex md:justify-end">
                        <form asp-action="Xoa" method="post">
                            <input type="hidden" name="maSP" value="@d.MaSP" />
                            <button type="submit" class="text-gray-400 hover:text-red-500 transition-colors text-xs uppercase font-bold">Xóa</button>
                        </form>
                    </div>
                </div>
            }
            </div>
        </div>

        <div class="w-full lg:w-1/3">
            <div class="bg-gray-50 p-6 md:p-8">
                <h2 class="text-xl font-extrabold uppercase mb-6 tracking-tight border-b border-gray-200 pb-4">Tóm tắt đơn hàng</h2>
                <div class="space-y-4 mb-6 text-sm font-medium">
                    <div class="flex justify-between"><span class="text-gray-600">Tạm tính (@Model.TongSoLuong sản phẩm)</span><span>@Model.TongTienHang.Dong()</span></div>
                    <div class="flex justify-between text-secondary"><span>Giảm giá đơn hàng</span><span>-@Model.TienGiamHoaDon.Dong()</span></div>
                </div>
                <div class="flex justify-between items-end border-t border-gray-200 pt-6 mb-8">
                    <span class="font-bold uppercase tracking-wider text-sm">Tổng thanh toán</span>
                    <span class="text-2xl font-extrabold tracking-tight">@Model.TongThanhToan.Dong()</span>
                </div>
                @if (Model.CoTheDatHang)
                {
                    <a asp-controller="DatHang" asp-action="Index" class="btn-dark w-full">Tiến hành đặt hàng</a>
                }
                else
                {
                    <button class="btn-dark w-full" disabled>Vui lòng chỉnh số lượng</button>
                }
            </div>

            <div class="mt-6 border border-gray-200 p-6">
                <h3 class="font-bold uppercase text-sm tracking-wider mb-4">Mã giảm giá</h3>
                @if (Model.LoiVoucher != null) { <div class="alert-err">@Model.LoiVoucher</div> }
                @if (Model.MaVoucher != null)
                {
                    <p class="text-sm mb-3">Đang áp dụng mã <strong>@Model.MaVoucher</strong>.</p>
                    <form asp-action="BoVoucher" method="post">
                        <button type="submit" class="text-xs font-bold uppercase underline hover:text-primary">Bỏ mã</button>
                    </form>
                }
                else
                {
                    <form asp-action="ApDungVoucher" method="post" class="flex gap-2">
                        <input type="text" name="maVoucher" class="input-box flex-1" placeholder="Nhập mã của bạn" maxlength="30" />
                        <button type="submit" class="bg-black text-white px-6 font-bold uppercase text-sm hover:bg-gray-800 transition-colors">Áp dụng</button>
                    </form>
                }
            </div>
        </div>
    </div>
}
</div>
