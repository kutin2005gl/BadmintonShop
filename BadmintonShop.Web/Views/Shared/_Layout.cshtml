
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BadmintonShop</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/BadmintonShop.Web.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <!-- Logo website -->
                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    BadmintonShop
                </a>

                <!-- Menu trên điện thoại -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Menu bên trái -->
                    <ul class="navbar-nav flex-grow-1">

                        <!-- Trang chủ -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        <!-- Danh sách sản phẩm -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="SanPham"
                               asp-action="Index">
                                Sản phẩm
                            </a>
                        </li>

                        <!-- Trang Privacy -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                    <!-- Menu tài khoản bên phải -->
                    <ul class="navbar-nav align-items-sm-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Hồ sơ cá nhân -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="TaiKhoan"
                                   asp-action="HoSo">
                                    Hồ sơ cá nhân
                                </a>
                            </li>

                            <!-- Đổi mật khẩu -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="TaiKhoan"
                                   asp-action="DoiMatKhau">
                                    Đổi mật khẩu
                                </a>
                            </li>

                            <!-- Tên khách hàng -->
                            <li class="nav-item">
                                <span class="nav-link text-dark">
                                    Xin chào, @User.Identity.Name
                                </span>
                            </li>

                            <!-- Đăng xuất -->
                            <li class="nav-item">
                                <form asp-area=""
                                      asp-controller="TaiKhoan"
                                      asp-action="DangXuat"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm ms-sm-2">
                                        Đăng xuất
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <!-- Đăng nhập -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="TaiKhoan"
                                   asp-action="DangNhap">
                                    Đăng nhập
                                </a>
                            </li>

                            <!-- Đăng ký -->
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm ms-sm-2"
                                   asp-area=""
                                   asp-controller="TaiKhoan"
                                   asp-action="DangKy">
                                    Đăng ký
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Nội dung chính của từng trang -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BadmintonShop -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
