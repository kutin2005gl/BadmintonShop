@model ErrorViewModel
@{ ViewData["Title"] = "Lỗi"; }

<div class="container mx-auto px-4 py-24 text-center">
    <h1 class="text-4xl font-extrabold uppercase tracking-tight mb-4 text-red-500">Đã xảy ra lỗi</h1>
    <p class="text-gray-500 mb-8">Có lỗi khi xử lý yêu cầu của bạn. Vui lòng thử lại sau.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-xs text-gray-400 mb-8">Mã yêu cầu: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn-dark">Về trang chủ</a>
</div>
