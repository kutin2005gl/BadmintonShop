@model TrangChuViewModel
@{
    ViewData["Title"] = "Trang chủ";
    string? TenDM(int ma) => Model.DanhMuc.FirstOrDefault(d => d.MaDM == ma)?.TenDanhMuc;
    TheSanPham Tao(BadmintonShop.Core.Models.SanPham sp, string? nhan) => new TheSanPham { SanPham = sp, TenDanhMuc = TenDM(sp.MaDM), Nhan = nhan };
    var nhanMoi = "MỚI"; var nhanChay = "BÁN CHẠY";
    var sanPhamMoi = Model.SanPham.OrderByDescending(x => x.MaSP).Take(8).ToList();
    var banChay = Model.SanPham.Where(x => !sanPhamMoi.Contains(x)).OrderBy(x => x.TenSP).Take(8).ToList();
}

<div class="w-full">
    <div class="relative w-full h-[60vh] md:h-[80vh] bg-gray-100 flex items-center">
        <div class="absolute inset-0">
            <img src="@AnhMinhHoa.Hero" alt="Hero Banner" class="w-full h-full object-cover brightness-75" />
        </div>
        <div class="container mx-auto px-4 relative z-10 text-white">
            <div class="max-w-xl">
                <h1 class="text-5xl md:text-7xl font-extrabold uppercase tracking-tighter mb-4 leading-none">Làm chủ<br />mọi trận đấu</h1>
                <p class="text-lg md:text-xl mb-8 font-medium text-gray-200">Trang bị chuyên nghiệp cho những cú đập cháy sân. Bộ sưu tập vợt, giày, quần áo và phụ kiện chính hãng đã cập bến.</p>
                <a href="/SanPham" class="inline-flex items-center justify-center bg-white text-black px-8 py-4 font-bold uppercase tracking-wider hover:bg-primary hover:text-white transition-colors">Mua ngay &rarr;</a>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4">
        @if (TempData["ThongBao"] is string tb) { <div class="alert-ok mt-8">@tb</div> }
        @if (TempData["Loi"] is string loi) { <div class="alert-err mt-8">@loi</div> }

        <div class="py-16">
            <h2 class="text-2xl md:text-3xl font-extrabold uppercase tracking-tight mb-8 text-center">Danh mục nổi bật</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                @foreach (var dm in Model.DanhMuc)
                {
                    <a href="/SanPham?maDM=@dm.MaDM" class="group relative aspect-square overflow-hidden bg-gray-100 block">
                        <img src="@AnhMinhHoa.TheoDanhMuc(dm.TenDanhMuc)" alt="@dm.TenDanhMuc" data-chu="@dm.TenDanhMuc.Substring(0, 1)" data-nen="bg-gray-600" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 mix-blend-multiply" />
                        <div class="absolute inset-0 bg-black/20 group-hover:bg-black/40 transition-colors flex items-end p-4 md:p-6">
                            <h3 class="text-white font-bold uppercase text-lg md:text-xl tracking-wide">@dm.TenDanhMuc</h3>
                        </div>
                    </a>
                }
            </div>
        </div>

        @if (sanPhamMoi.Count > 0)
        {
            <div class="my-16">
                <div class="flex items-end justify-between mb-8">
                    <h2 class="text-2xl md:text-3xl font-extrabold uppercase tracking-tight">Sản phẩm mới</h2>
                    <div class="flex gap-2">
                        <button type="button" data-cuon="trai" data-muc="cr-moi" class="w-10 h-10 border border-black flex items-center justify-center hover:bg-black hover:text-white transition-colors">&lsaquo;</button>
                        <button type="button" data-cuon="phai" data-muc="cr-moi" class="w-10 h-10 border border-black flex items-center justify-center hover:bg-black hover:text-white transition-colors">&rsaquo;</button>
                    </div>
                </div>
                <div id="cr-moi" class="flex gap-4 md:gap-6 overflow-x-auto snap-x snap-mandatory pb-4" style="scrollbar-width:none">
                    @foreach (var sp in sanPhamMoi)
                    {
                        <div class="min-w-[240px] md:min-w-[280px] snap-start">
                            <partial name="_SanPhamCard" model="Tao(sp, nhanMoi)" />
                        </div>
                    }
                </div>
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 py-8">
            <div class="relative h-[300px] md:h-[400px] overflow-hidden group">
                <img src="@AnhMinhHoa.BannerGiay" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" alt="Giày" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-8 text-white">
                    <span class="text-sm font-bold uppercase tracking-wider mb-2 text-primary">Ưu đãi hấp dẫn</span>
                    <h3 class="text-3xl font-extrabold uppercase tracking-tight mb-4">Giày Cầu Lông</h3>
                    <a href="/SanPham" class="underline font-bold uppercase text-sm w-fit hover:text-primary transition-colors">Khám phá ngay</a>
                </div>
            </div>
            <div class="relative h-[300px] md:h-[400px] overflow-hidden group">
                <img src="@AnhMinhHoa.BannerVot" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" alt="Vợt" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex flex-col justify-end p-8 text-white">
                    <span class="text-sm font-bold uppercase tracking-wider mb-2 text-secondary">Hàng mới về</span>
                    <h3 class="text-3xl font-extrabold uppercase tracking-tight mb-4">Dòng Vợt Trợ Lực</h3>
                    <a href="/SanPham" class="underline font-bold uppercase text-sm w-fit hover:text-secondary transition-colors">Mua ngay</a>
                </div>
            </div>
        </div>

        @if (banChay.Count > 0)
        {
            <div class="my-16">
                <div class="flex items-end justify-between mb-8">
                    <h2 class="text-2xl md:text-3xl font-extrabold uppercase tracking-tight">Bán chạy nhất</h2>
                    <div class="flex gap-2">
                        <button type="button" data-cuon="trai" data-muc="cr-chay" class="w-10 h-10 border border-black flex items-center justify-center hover:bg-black hover:text-white transition-colors">&lsaquo;</button>
                        <button type="button" data-cuon="phai" data-muc="cr-chay" class="w-10 h-10 border border-black flex items-center justify-center hover:bg-black hover:text-white transition-colors">&rsaquo;</button>
                    </div>
                </div>
                <div id="cr-chay" class="flex gap-4 md:gap-6 overflow-x-auto snap-x snap-mandatory pb-4" style="scrollbar-width:none">
                    @foreach (var sp in banChay)
                    {
                        <div class="min-w-[240px] md:min-w-[280px] snap-start">
                            <partial name="_SanPhamCard" model="Tao(sp, nhanChay)" />
                        </div>
                    }
                </div>
            </div>
        }

        <div class="py-16 border-t border-gray-100">
            <h2 class="text-2xl font-extrabold uppercase tracking-tight mb-10 text-center">Thương hiệu hàng đầu</h2>
            <div class="flex flex-wrap justify-center gap-8 md:gap-16 opacity-60">
                @foreach (var b in new[] { "YONEX", "LI-NING", "VICTOR", "MIZUNO", "KUMPOO" })
                {
                    <span class="text-2xl md:text-4xl font-extrabold tracking-tighter text-gray-400 hover:text-black transition-colors cursor-pointer uppercase">@b</span>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Carousel: nut trai/phai cuon ngang
    document.querySelectorAll('[data-cuon]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var el = document.getElementById(btn.dataset.muc);
            el.scrollBy({ left: (btn.dataset.cuon === 'trai' ? -1 : 1) * el.offsetWidth, behavior: 'smooth' });
        });
    });

</script>
}
