@model ChiTietDonViewModel
@using System.Data
@{
    var hd = Model.Don;
    ViewData["Title"] = "Đơn hàng #" + hd.MaHD;
    var cacBuoc = new[] { "Chờ xác nhận", "Đã xác nhận", "Đang giao", "Hoàn thành" };
    var viTri = Array.IndexOf(cacBuoc, hd.TrangThai);
    decimal tienHang = 0;
    foreach (DataRow r in Model.Dong.Rows) { tienHang += (decimal)r["ThanhTien"]; }
}

<a asp-action="Index" class="btn btn-link px-0">&larr; Đơn hàng của tôi</a>
<h2 class="mb-3">Đơn hàng #@hd.MaHD <span class="badge fs-6 @DinhDang.MauTrangThai(hd.TrangThai)">@hd.TrangThai</span></h2>

@if (TempData["ThongBao"] is string tb) { <div class="alert alert-success">@tb</div> }
@if (TempData["Loi"] is string loi) { <div class="alert alert-danger">@loi</div> }

@if (hd.TrangThai == "Đã hủy")
{
    <div class="alert alert-danger">Đơn hàng này đã bị hủy.</div>
}
else
{
    <ol class="list-unstyled d-flex flex-wrap gap-3 mb-4">
        @for (var i = 0; i < cacBuoc.Length; i++)
        {
            <li><span class="badge @(i <= viTri ? "bg-success" : "bg-secondary")">@(i + 1). @cacBuoc[i]</span></li>
        }
    </ol>
}

<div class="row g-4">
    <div class="col-md-8">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Sản phẩm</th><th class="text-end">Đơn giá</th><th class="text-center">SL</th><th class="text-end">Thành tiền</th></tr></thead>
                <tbody>
                @foreach (DataRow r in Model.Dong.Rows)
                {
                    var gg = (decimal)r["GiamGia"];
                    <tr>
                        <td>@r["TenSP"]</td>
                        <td class="text-end">
                            @(((decimal)r["DonGia"]).Dong())
                            @if (gg > 0) { <span class="badge bg-danger">-@gg.ToString("0.##")%</span> }
                        </td>
                        <td class="text-center">@r["SoLuong"]</td>
                        <td class="text-end">@(((decimal)r["ThanhTien"]).Dong())</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between"><span>Tiền hàng</span><span>@tienHang.Dong()</span></div>
                <div class="d-flex justify-content-between text-success"><span>Giảm giá đơn</span><span>-@hd.TienGiamGia.Dong()</span></div>
                <hr />
                <div class="d-flex justify-content-between fw-bold fs-5"><span>Tổng cộng</span><span>@hd.TongTien.Dong()</span></div>
                <hr />
                <div class="small">Ngày đặt: @hd.NgayLap.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="small">Thanh toán: @(hd.HinhThucTT == "COD" ? "Khi nhận hàng (COD)" : "Online")</div>
                <div class="small">Giao tới: @hd.DiaChiGiao</div>
                @if (hd.TrangThai == "Chờ xác nhận")
                {
                    <form asp-action="Huy" asp-route-id="@hd.MaHD" method="post" class="mt-3"
                          onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn hàng này?');">
                        <button type="submit" class="btn btn-outline-danger w-100">Hủy đơn hàng</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
