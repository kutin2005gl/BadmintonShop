@model ChiTietDonViewModel
@using System.Data
@{
    var hd = Model.Don;
    ViewData["Title"] = "Đơn hàng #" + hd.MaHD;
    var cacBuoc = new[] { "Chờ xác nhận", "Đã xác nhận", "Đang giao", "Hoàn thành" };
    var viTri = Array.IndexOf(cacBuoc, hd.TrangThai);
    decimal tienHang = 0;
    foreach (DataRow r in Model.Dong.Rows) { tienHang += (decimal)r["ThanhTien"]; }
}

<div class="container mx-auto px-4 py-12">
<a asp-action="Index" class="text-xs font-bold uppercase underline hover:text-primary">&larr; Đơn hàng của tôi</a>
<h1 class="page-title mt-4">Đơn hàng #@hd.MaHD <span class="badge align-middle @DinhDang.MauTrangThai(hd.TrangThai)">@hd.TrangThai</span></h1>

@if (TempData["ThongBao"] is string tb) { <div class="alert-ok">@tb</div> }
@if (TempData["Loi"] is string loi) { <div class="alert-err">@loi</div> }

@if (hd.TrangThai == "Đã hủy")
{
    <div class="alert-err">Đơn hàng này đã bị hủy. @hd.LyDoHuy</div>
}
else
{
    <ol class="flex flex-wrap gap-2 mb-8">
        @for (var i = 0; i < cacBuoc.Length; i++)
        {
            <li><span class="badge @(i <= viTri ? "bg-secondary text-white" : "bg-gray-200 text-gray-600")">@(i + 1). @cacBuoc[i]</span></li>
        }
    </ol>
}

<div class="flex flex-col lg:flex-row gap-12">
    <div class="w-full lg:w-2/3 overflow-x-auto">
        <table class="w-full text-sm">
            <thead><tr class="border-b border-black text-left text-xs font-bold uppercase tracking-wider text-gray-500"><th class="py-3">Sản phẩm</th><th class="py-3 text-right">Đơn giá</th><th class="py-3 text-center">SL</th><th class="py-3 text-right">Thành tiền</th></tr></thead>
            <tbody>
            @foreach (DataRow r in Model.Dong.Rows)
            {
                var gg = (decimal)r["GiamGia"];
                <tr class="border-b border-gray-200">
                    <td class="py-4 font-medium">@r["TenSP"]</td>
                    <td class="py-4 text-right">
                        @(((decimal)r["DonGia"]).Dong())
                        @if (gg > 0) { <span class="badge bg-red-500 text-white">-@gg.ToString("0.##")%</span> }
                    </td>
                    <td class="py-4 text-center">@r["SoLuong"]</td>
                    <td class="py-4 text-right font-bold">@(((decimal)r["ThanhTien"]).Dong())</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="w-full lg:w-1/3">
        <div class="bg-gray-50 p-6 md:p-8">
            <div class="space-y-3 text-sm font-medium">
                <div class="flex justify-between"><span class="text-gray-600">Tiền hàng</span><span>@tienHang.Dong()</span></div>
                <div class="flex justify-between text-secondary"><span>Giảm giá đơn</span><span>-@hd.TienGiamGia.Dong()</span></div>
            </div>
            <div class="flex justify-between items-end border-t border-gray-200 pt-4 mt-4">
                <span class="font-bold uppercase tracking-wider text-sm">Tổng cộng</span>
                <span class="text-2xl font-extrabold tracking-tight">@hd.TongTien.Dong()</span>
            </div>
            <div class="border-t border-gray-200 mt-6 pt-4 text-xs text-gray-600 space-y-1">
                <div>Ngày đặt: @hd.NgayLap.ToString("dd/MM/yyyy HH:mm")</div>
                <div>Thanh toán: @(hd.HinhThucTT == "COD" ? "Khi nhận hàng (COD)" : "Online")</div>
                <div>Giao tới: @hd.DiaChiGiao</div>
            </div>
            @if (hd.TrangThai == "Chờ xác nhận")
            {
                <form asp-action="Huy" asp-route-id="@hd.MaHD" method="post" class="mt-6"
                      onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn hàng này?');">
                    <button type="submit" class="btn-outline w-full !border-red-500 !text-red-500 hover:!bg-red-500 hover:!text-white">Hủy đơn hàng</button>
                </form>
            }
        </div>
    </div>
</div>
</div>
