@model System.Data.DataTable
@using System.Data
@{ ViewData["Title"] = "Đơn hàng của tôi"; }

<div class="container mx-auto px-4 py-12">
<h1 class="page-title">Đơn hàng của tôi</h1>
@if (TempData["ThongBao"] is string tb) { <div class="alert-ok">@tb</div> }
@if (TempData["Loi"] is string loi) { <div class="alert-err">@loi</div> }

@if (Model.Rows.Count == 0)
{
    <div class="flex flex-col items-center text-center py-16">
        <p class="text-gray-500 mb-8">Bạn chưa có đơn hàng nào.</p>
        <a asp-controller="Home" asp-action="Index" class="btn-dark">Mua sắm ngay</a>
    </div>
}
else
{
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-black text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                    <th class="py-3 pr-4">Mã đơn</th><th class="py-3 pr-4">Ngày đặt</th><th class="py-3 pr-4">Thanh toán</th>
                    <th class="py-3 pr-4 text-right">Tổng tiền</th><th class="py-3 pr-4">Trạng thái</th><th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (DataRow r in Model.Rows)
            {
                var tt = (string)r["TrangThai"];
                <tr class="border-b border-gray-200 hover:bg-gray-50 cursor-pointer" tabindex="0"
                    data-order-detail="@Url.Action("ChiTietDong", new { id = r["MaHD"] })" aria-label="Xem đơn hàng @r["MaHD"]">
                    <td class="py-4 pr-4 font-bold">#@r["MaHD"]</td>
                    <td class="py-4 pr-4">@(((DateTime)r["NgayLap"]).ToString("dd/MM/yyyy HH:mm"))</td>
                    <td class="py-4 pr-4">@r["HinhThucTT"]</td>
                    <td class="py-4 pr-4 text-right font-bold">@(((decimal)r["TongTien"]).Dong())</td>
                    <td class="py-4 pr-4"><span class="badge @DinhDang.MauTrangThai(tt)">@tt</span></td>
                    <td class="py-4 text-right"><a asp-action="ChiTiet" asp-route-id="@r["MaHD"]" class="text-xs font-bold uppercase underline hover:text-primary">Xem</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <section id="order-detail" class="mt-8" aria-label="Chi tiết đơn được chọn" aria-live="polite">
        <p class="text-gray-500">Chọn một ô trên dòng đơn hàng để xem chi tiết.</p>
    </section>
}
</div>

@section Scripts {
<script src="~/js/order-main-sub.js" asp-append-version="true"></script>
}
