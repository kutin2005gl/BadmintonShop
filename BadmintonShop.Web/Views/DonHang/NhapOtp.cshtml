@model TraCuuDonViewModel
@{ ViewData["Title"] = "Xác thực OTP"; }

<div class="auth-khung">
    <div class="auth-card">
        <h1 class="auth-title">Nhập mã OTP</h1>
        <p class="auth-sub">Mã xác thực 6 chữ số đã được gửi tới số <strong>@Model.SDT</strong>.</p>

        @* DEMO: chua tich hop SMS, nhap 6 chu so bat ky de tiep tuc *@
        <div class="alert-ok">[DEMO] Chưa gửi SMS thật — nhập 6 chữ số bất kỳ để tiếp tục.</div>

        <form asp-controller="DonHang" asp-action="NhapOtp" method="post" autocomplete="off">
            @if (Model.Loi != null) { <div class="alert-err">@Model.Loi</div> }

            <div class="field">
                <label for="otp" class="field-label">Mã OTP</label>
                <input id="otp" name="otp" class="input-box tracking-[0.5em] text-center" inputmode="numeric" autocomplete="one-time-code"
                       pattern="\d{6}" maxlength="6" placeholder="••••••" required autofocus />
            </div>

            <button type="submit" class="btn-dark w-full mt-2">Xác nhận</button>
        </form>

        <div class="border-t border-gray-200 mt-8 pt-6 text-sm text-gray-600 text-center">
            Sai số điện thoại?
            <a asp-action="TraCuu" class="link-sub ml-1">Nhập lại</a>
        </div>
    </div>
</div>
